# Production environment template for pulseflow-collab (copy to .env.production — never commit real secrets)
PULSEFLOW_ENV=production
PULSEFLOW_PORT=8095
POSTGRES_URL=postgresql://pulseflow_prod_role:REPLACE_WITH_VAULT_SECRET@pg-prod.internal.example.com:5432/pulseflow_collab_prod?sslmode=require
REDIS_URL=rediss://:REPLACE_WITH_VAULT_SECRET@redis-prod.internal.example.com:6379/0
PRESENCE_TTL_SECONDS=45
