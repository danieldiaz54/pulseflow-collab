# Development environment template for pulseflow-collab (copy to .env.development — never commit real secrets)
PULSEFLOW_ENV=development
PULSEFLOW_PORT=8095
PULSEFLOW_SQLITE_PATH=./data/pulseflow-dev.sqlite3
POSTGRES_URL=postgresql://pulseflow_dev:pulseflow_dev_local@localhost:5439/pulseflow_collab_dev
REDIS_URL=redis://localhost:6385/0
PRESENCE_TTL_SECONDS=45
